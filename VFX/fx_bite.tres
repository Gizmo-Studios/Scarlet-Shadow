code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color;
uniform sampler2D tex_frg_4;
uniform float FloatParameter;
uniform sampler2D tex_frg_15;
uniform sampler2D tex_frg_9;
uniform sampler2D tex_frg_17;
uniform float FloatParameter2;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = ColorParameter;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, UV);
	float n_out4p1 = n_out4p0.r;


// VectorOp:3
	vec4 n_out3p0 = n_out2p0 * vec4(n_out4p1);


// FloatFunc:5
	float n_out5p0 = 1.0 - n_out4p1;


// VectorOp:10
	vec4 n_in10p1 = vec4(0.00000, 0.00000, 0.00000, 0.00000);
	vec4 n_out10p0 = vec4(n_out5p0) + n_in10p1;


// FloatParameter:13
	float n_out13p0 = FloatParameter;


// VectorOp:12
	vec3 n_out12p0 = vec3(n_out10p0.xyz) - vec3(n_out13p0);


// Clamp:14
	vec3 n_in14p1 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in14p2 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out14p0 = clamp(n_out12p0, n_in14p1, n_in14p2);


// Texture2D:15
	vec4 n_out15p0 = texture(tex_frg_15, vec2(n_out14p0.xy));


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, UV);
	float n_out9p1 = n_out9p0.r;


// VectorOp:11
	vec4 n_out11p0 = n_out15p0 * vec4(n_out9p1);


// VectorOp:8
	vec4 n_out8p0 = n_out3p0 + n_out11p0;


// Texture2D:17
	vec4 n_out17p0 = texture(tex_frg_17, UV);


// FloatParameter:19
	float n_out19p0 = FloatParameter2;


// VectorOp:21
	vec3 n_out21p0 = vec3(n_out17p0.xyz) - vec3(n_out19p0);


// Clamp:20
	vec3 n_in20p1 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in20p2 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out20p0 = clamp(n_out21p0, n_in20p1, n_in20p2);


// VectorOp:16
	vec4 n_out16p0 = n_out8p0 + vec4(n_out20p0, 0.0);


// Clamp:18
	vec4 n_in18p1 = vec4(0.00000, 0.00000, 0.00000, 0.00000);
	vec4 n_in18p2 = vec4(1.00000, 1.00000, 1.00000, 1.00000);
	vec4 n_out18p0 = clamp(n_out16p0, n_in18p1, n_in18p2);


// Output:0
	COLOR.rgb = vec3(n_out18p0.xyz);


}
"
